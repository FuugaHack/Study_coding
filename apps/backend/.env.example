# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/learning_platform

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_MAX_TOKENS=16000
AI_EFFORT=medium
# Bedrock の認証: Amazon Bedrock API キー (bedrock-mantle:CallWithBearerToken と
# bedrock-mantle:CreateInference の権限が必要)。または AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_BEARER_TOKEN_BEDROCK=

# Auth
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=100

# AI レビュー (Bedrock の認証情報がない環境では false にすると分かりやすい)
AI_REVIEW_ENABLED=true

# コード実行ランナー (docker-compose.yml の runner と同じ値にする。本番では必ず変更)
RUNNER_SOCKET=/sock/runner.sock
RUNNER_TOKEN=change-me-runner-token
RUNNER_RATE_LIMIT_PER_MINUTE=20

# AI ワーカー (docs/expansion/m4-design.md)
AI_WORKER_CONCURRENCY=2
AI_TASK_TIMEOUT_S=180
AI_TASK_MAX_ATTEMPTS=3

# AI の費用計測と利用上限 (単価は USD / 100 万トークン。使うモデルの価格に合わせる)
AI_PRICE_INPUT_PER_MTOK=4.0
AI_PRICE_OUTPUT_PER_MTOK=20.0
AI_USER_DAILY_TOKEN_LIMIT=200000
AI_GLOBAL_DAILY_COST_LIMIT_USD=10.0

# ログ: json / console
LOG_FORMAT=json
LOG_LEVEL=INFO
